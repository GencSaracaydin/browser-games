<!--
  OPERATION LONG SHADOW link.xml (WP01, TECH_PLAN §3.1 managed stripping High, R5, §7.1).
  S_Boot is the only Build Settings scene (D1): every other scene, prefab and library ScriptableObject arrives in an
  Addressables bundle, so the linker never sees most of our types. Addressables writes its own link.xml for the types it
  finds in bundles (Library/com.unity.addressables/aa/WebGL/AddressablesLink/link.xml, added to the player build
  automatically); this file adds what that analysis cannot see:
    * all of our runtime assemblies (library ScriptableObjects, markup, components instantiated only from bundles,
      [SerializeReference] payloads, JsonUtility save records);
    * the Addressables/ResourceManager providers created by type name from the catalog;
    * packages that build objects by name or through jobs (Input System processors/interactions from the actions asset,
      Timeline playables, Animation Rigging constraints, TextMesh Pro, uGUI, AI Navigation, Splines);
    * the URP volume components our profiles use (instantiated from VolumeProfile assets in bundles).
  An EditMode test (LinkXmlTests) fails when a LongShadow runtime assembly is missing here.
-->
<linker>
  <!-- Our runtime assemblies -->
  <assembly fullname="LongShadow.Core" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="LongShadow.Input" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="LongShadow.Platform" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="LongShadow.Player" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="LongShadow.Combat" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="LongShadow.AI" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="LongShadow.Characters" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="LongShadow.Audio" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="LongShadow.Mission" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="LongShadow.UI" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="LongShadow.Cinematics" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="LongShadow.World.Look" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="LongShadow.World.Level" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="LongShadow.Integration" preserve="all" ignoreIfMissing="1"/>

  <!-- Addressables: providers and locators are created from type names stored in the catalog -->
  <assembly fullname="Unity.Addressables" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.ResourceManager" preserve="all" ignoreIfMissing="1"/>

  <!-- Packages that instantiate by name or reflection -->
  <assembly fullname="Unity.InputSystem" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Timeline" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Animation.Rigging" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.TextMeshPro" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="UnityEngine.UI" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.AI.Navigation" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.Splines" preserve="all" ignoreIfMissing="1"/>

  <!-- URP volume overrides used by Settings/Volumes profiles and the runtime option volumes (QualityApplier) -->
  <assembly fullname="Unity.RenderPipelines.Universal.Runtime" ignoreIfMissing="1">
    <type fullname="UnityEngine.Rendering.Universal.Bloom" preserve="all"/>
    <type fullname="UnityEngine.Rendering.Universal.ChannelMixer" preserve="all"/>
    <type fullname="UnityEngine.Rendering.Universal.ChromaticAberration" preserve="all"/>
    <type fullname="UnityEngine.Rendering.Universal.ColorAdjustments" preserve="all"/>
    <type fullname="UnityEngine.Rendering.Universal.ColorCurves" preserve="all"/>
    <type fullname="UnityEngine.Rendering.Universal.ColorLookup" preserve="all"/>
    <type fullname="UnityEngine.Rendering.Universal.DepthOfField" preserve="all"/>
    <type fullname="UnityEngine.Rendering.Universal.FilmGrain" preserve="all"/>
    <type fullname="UnityEngine.Rendering.Universal.LensDistortion" preserve="all"/>
    <type fullname="UnityEngine.Rendering.Universal.LiftGammaGain" preserve="all"/>
    <type fullname="UnityEngine.Rendering.Universal.MotionBlur" preserve="all"/>
    <type fullname="UnityEngine.Rendering.Universal.PaniniProjection" preserve="all"/>
    <type fullname="UnityEngine.Rendering.Universal.ShadowsMidtonesHighlights" preserve="all"/>
    <type fullname="UnityEngine.Rendering.Universal.SplitToning" preserve="all"/>
    <type fullname="UnityEngine.Rendering.Universal.Tonemapping" preserve="all"/>
    <type fullname="UnityEngine.Rendering.Universal.Vignette" preserve="all"/>
    <type fullname="UnityEngine.Rendering.Universal.WhiteBalance" preserve="all"/>
    <type fullname="UnityEngine.Rendering.Universal.ScreenSpaceAmbientOcclusion" preserve="all"/>
    <type fullname="UnityEngine.Rendering.Universal.DecalRendererFeature" preserve="all"/>
    <type fullname="UnityEngine.Rendering.Universal.FullScreenPassRendererFeature" preserve="all"/>
    <!-- WP10_LOOK (REQUESTS 2026-10-16): light data on lights that exist only in bundles -->
    <type fullname="UnityEngine.Rendering.Universal.UniversalAdditionalLightData" preserve="all"/>
    <type fullname="UnityEngine.Rendering.Universal.UniversalAdditionalCameraData" preserve="all"/>
  </assembly>

  <!-- WP10_LOOK (REQUESTS 2026-10-16): SRP core types instantiated only from bundles (lens flare, volumes) -->
  <assembly fullname="Unity.RenderPipelines.Core.Runtime" ignoreIfMissing="1">
    <type fullname="UnityEngine.Rendering.LensFlareComponentSRP" preserve="all"/>
    <type fullname="UnityEngine.Rendering.LensFlareDataSRP" preserve="all"/>
    <type fullname="UnityEngine.Rendering.Volume" preserve="all"/>
    <type fullname="UnityEngine.Rendering.VolumeProfile" preserve="all"/>
  </assembly>

  <!-- Engine module types referenced only by S_Persistent / section bundles (engine-code stripping) -->
  <assembly fullname="UnityEngine.WindModule" ignoreIfMissing="1">
    <type fullname="UnityEngine.WindZone" preserve="all"/>
  </assembly>
  <assembly fullname="UnityEngine.CoreModule" ignoreIfMissing="1">
    <type fullname="UnityEngine.LightProbeGroup" preserve="all"/>
  </assembly>
</linker>
