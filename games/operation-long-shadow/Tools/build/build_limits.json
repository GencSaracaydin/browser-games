{
  "_comment": "Web build and artifact-host limits (TECH_PLAN §8.10, §9.1-9.2, D22; host limits measured 2026-10-16). Read by Tools/build/validate_build.py, Tools/build/publish_plan.py and LongShadow.Platform.Editor.PostBuildValidator. Sizes are decimal bytes.",
  "max_file_bytes": 14500000,
  "max_text_file_bytes": 16000000,
  "max_bundle_bytes": 12000000,
  "max_files": 250,
  "max_total_bytes": 230000000,
  "warn_total_bytes": 220000000,
  "max_reflection_probe_px": 256,
  "publish_batch_max_bytes": 60000000,
  "publish_batch_max_files": 250,
  "host_call_max_bytes": 64000000,
  "host_call_max_files": 255,
  "host_version_max_bytes": 256000000,
  "host_version_max_files": 511,
  "host_binary_max_bytes": 15000000,
  "host_text_max_bytes": 16000000,
  "publish_suffix": ".wasm",
  "served_extensions": [
    "html", "css", "js", "mjs", "wasm", "json", "map", "geojson", "webmanifest", "txt", "md", "csv", "xml", "svg",
    "png", "jpg", "jpeg", "gif", "webp", "avif", "ico", "woff", "woff2", "ttf", "otf", "mp3", "wav", "ogg", "mp4",
    "webm", "pdf"
  ],
  "text_extensions": ["html", "css", "js", "mjs", "json", "map", "geojson", "webmanifest", "txt", "md", "csv", "xml", "svg", "hash"],
  "strip_patterns": ["*.manifest", ".DS_Store", "Thumbs.db"],
  "allowed_prefixes": ["index.html", "Build/", "StreamingAssets/aa/", "StreamingAssets/video/", "TemplateData/"],
  "content_types": {
    "html": "text/html",
    "css": "text/css",
    "js": "text/javascript",
    "mjs": "text/javascript",
    "wasm": "application/wasm",
    "json": "application/json",
    "map": "application/json",
    "txt": "text/plain",
    "md": "text/markdown",
    "csv": "text/csv",
    "xml": "application/xml",
    "svg": "image/svg+xml",
    "png": "image/png",
    "jpg": "image/jpeg",
    "jpeg": "image/jpeg",
    "gif": "image/gif",
    "webp": "image/webp",
    "avif": "image/avif",
    "ico": "image/x-icon",
    "woff": "font/woff",
    "woff2": "font/woff2",
    "ttf": "font/ttf",
    "otf": "font/otf",
    "mp3": "audio/mpeg",
    "wav": "audio/wav",
    "ogg": "audio/ogg",
    "mp4": "video/mp4",
    "webm": "video/webm",
    "pdf": "application/pdf",
    "webmanifest": "application/manifest+json",
    "geojson": "application/geo+json"
  }
}
